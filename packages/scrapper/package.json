{
  "name": "@urban-transparency/scrapper",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "scrape:placsp": "tsx --env-file=../../.env scripts/scrape-placsp.ts",

    "scrape:placsp:cantabria": "tsx --env-file=../../.env scripts/scrape-placsp.ts --province 39 --max-pages 10 --delay-ms 1500",
    "scrape:placsp:cantabria:backfill": "tsx --env-file=../../.env scripts/scrape-placsp.ts --province 39 --max-pages 50 --delay-ms 1500",
    "scrape:placsp:pais-vasco": "tsx --env-file=../../.env scripts/scrape-placsp.ts --province 01 --province 20 --province 48 --max-pages 10 --delay-ms 1500",
    "scrape:placsp:pais-vasco:backfill": "tsx --env-file=../../.env scripts/scrape-placsp.ts --province 01 --province 20 --province 48 --max-pages 50 --delay-ms 1500",
    "scrape:placsp:asturias": "tsx --env-file=../../.env scripts/scrape-placsp.ts --province 33 --max-pages 10 --delay-ms 1500",
    "scrape:placsp:asturias:backfill": "tsx --env-file=../../.env scripts/scrape-placsp.ts --province 33 --max-pages 50 --delay-ms 1500",

    "scrape:dirce": "tsx --env-file=../../.env scripts/scrape-dirce.ts",
    "scrape:dirce:cantabria": "tsx --env-file=../../.env scripts/scrape-dirce.ts --province 39",
    "scrape:dirce:pais-vasco": "tsx --env-file=../../.env scripts/scrape-dirce.ts --province 01 --province 20 --province 48",
    "scrape:dirce:asturias": "tsx --env-file=../../.env scripts/scrape-dirce.ts --province 33",

    "scrape:adrh": "tsx --env-file=../../.env scripts/scrape-adrh.ts",
    "scrape:adrh:cantabria": "tsx --env-file=../../.env scripts/scrape-adrh.ts --province 39",
    "scrape:adrh:pais-vasco": "tsx --env-file=../../.env scripts/scrape-adrh.ts --province 01 --province 20 --province 48",
    "scrape:adrh:asturias": "tsx --env-file=../../.env scripts/scrape-adrh.ts --province 33",

    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@urban-transparency/database": "workspace:*",
    "@urban-transparency/shared": "workspace:*",
    "fast-xml-parser": "^5.3.0",
    "puppeteer": "^25.14.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
