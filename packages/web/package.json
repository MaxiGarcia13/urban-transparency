{
  "name": "@urban-transparency/web",
  "type": "module",
  "version": "0.0.26",
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules dist .astro",

    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",

    "fetch:region-boundary": "tsx scripts/fetch-region-boundary.ts",
    "fetch:region-boundary:cantabria": "tsx scripts/fetch-region-boundary.ts --id cantabria --name Cantabria --query Cantabria --province 39",
    "fetch:region-boundary:pais-vasco": "tsx scripts/fetch-region-boundary.ts --id pais-vasco --name \"País Vasco\" --query \"Comunidad Autónoma del País Vasco\" --province 01 --province 20 --province 48",
    "fetch:region-boundary:asturias": "tsx scripts/fetch-region-boundary.ts --id asturias --name Asturias --query \"Principado de Asturias\" --province 33",

    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.3",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@nanostores/vue": "^1.1.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/vue-query": "^5.104.2",
    "@tanstack/vue-virtual": "^3.13.47",
    "@urban-transparency/database": "workspace:*",
    "@urban-transparency/shared": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "maplibre-gl": "^6.14.0",
    "nanostores": "^1.5.5",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@astrojs/vercel": "^11.0.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  }
}
