---
import { SalaryIncomeAsidePanel, SalaryIncomePreview } from '@/components/metric-shell';
import { PRODUCT_NAME } from '@/config/product';
import MetricShell from '@/layouts/metric-shell.astro';

const title = `${PRODUCT_NAME} - Renta y salarios`;
const description = 'Dónde hay más renta neta media por municipio en España (INE ADRH)';
---

<MetricShell title={title} description={description}>
  <div slot="aside-panel" class="contents">
    <SalaryIncomeAsidePanel client:load />
  </div>
  <SalaryIncomePreview client:load class="h-full" />
</MetricShell>
