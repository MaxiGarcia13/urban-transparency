---
import { BusinessPowerAsidePanel, BusinessPowerPreview } from '@/components/metric-shell';
import { PRODUCT_NAME } from '@/config/product';
import MetricShell from '@/layouts/metric-shell.astro';

const title = `${PRODUCT_NAME} - Poder empresarial`;
const description = 'Actividad empresarial por municipio en España';
---

<MetricShell title={title} description={description}>
  <div slot="aside-panel" class="contents">
    <BusinessPowerAsidePanel client:load />
  </div>
  <BusinessPowerPreview client:load class="h-full" />
</MetricShell>
