---
import MetricApp from '@/components/metric-app.vue';
import { PRODUCT_NAME } from '@/config/product';
import BaseLayout from '@/layouts/base-layout.astro';

const title = `${PRODUCT_NAME} - Spain`;
const description = 'Gasto público y datos urbanos sobre el mapa de España';
---

<BaseLayout title={title} description={description}>
  <MetricApp client:only="vue" />
</BaseLayout>
