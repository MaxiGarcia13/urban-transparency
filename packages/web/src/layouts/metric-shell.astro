---
import { ClientRouter } from 'astro:transitions';
import MetricNav from '@/components/metric-nav/metric-nav.vue';
import MetricAside from '@/components/metric-shell/metric-aside.vue';
import { metricIdFromPath } from '@/config/metrics';
import { CANTABRIA_REGION_ID, MAP_REGIONS } from '@/config/regions';
import { parseBusinessPowerFiltersFromSearchParams } from '@/domain/business-power-filters-query';
import { parseMapRegionIdFromSearchParams } from '@/domain/map-region-query';
import { parsePublicContractFiltersFromSearchParams } from '@/domain/public-contract-filters-query';
import BaseLayout from '@/layouts/base-layout.astro';

type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
const metricId = metricIdFromPath(Astro.url.pathname);
const regionId = parseMapRegionIdFromSearchParams(
  Astro.url.searchParams,
  MAP_REGIONS.map((region) => region.id),
  CANTABRIA_REGION_ID,
);
const filters = parsePublicContractFiltersFromSearchParams(Astro.url.searchParams);
const businessPowerFilters = parseBusinessPowerFiltersFromSearchParams(Astro.url.searchParams);
---

<BaseLayout title={title} description={description}>
  <ClientRouter slot="head" />

  <div class="relative h-dvh overflow-hidden bg-zinc-950 lg:flex lg:flex-row">
    <div class="pointer-events-none absolute inset-x-0 top-0 z-20 p-4 lg:pointer-events-auto lg:static lg:inset-auto lg:flex lg:h-full lg:w-md lg:shrink-0 lg:border-r lg:border-white/10 lg:p-0">
      <div
        data-metric-aside-panel
        class="pointer-events-auto flex max-h-[min(70dvh,100%)] w-full flex-col overflow-hidden rounded-xl border border-white/10 bg-zinc-950/90 shadow-lg backdrop-blur-md lg:h-full lg:max-h-none lg:rounded-none lg:border-0 lg:bg-zinc-950 lg:shadow-none lg:backdrop-blur-none"
      >
        <MetricNav client:load activeMetricId={metricId} />
        <MetricAside
          client:load
          metricId={metricId}
          regionId={regionId}
          filters={filters}
          businessPowerFilters={businessPowerFilters}
        />
        <slot name="aside-panel" />
      </div>
    </div>

    <div class="relative h-full min-h-0 w-full bg-zinc-950 lg:flex-1">
      <slot />
    </div>
  </div>
</BaseLayout>
