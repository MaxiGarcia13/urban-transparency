{
  "name": "urban-transparency",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [
    "urban",
    "transparency",
    "public",
    "contracts",
    "spending",
    "map",
    "data",
    "visualization"
  ],
  "main": "index.js",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "prepare": "simple-git-hooks",

    "build": "pnpm --filter=@urban-transparency/web build",
    "preview": "pnpm --filter=@urban-transparency/web preview",
    "dev": "pnpm --filter=@urban-transparency/web dev",

    "lint": "eslint . --ignore-pattern 'packages/web/**' && pnpm -r --if-present run lint",
    "lint:fix": "eslint --fix . --ignore-pattern 'packages/web/**' && pnpm -r --if-present run lint:fix",

    "clean": "rm -rf node_modules dist && pnpm -r run clean",
    "phoenix": "pnpm clean && pnpm install",

    "release": "nx release --skip-publish",
    "release:dry": "nx release --dry-run",

    "scrape:placsp": "pnpm --filter=@urban-transparency/scrapper scrape:placsp",
    "scrape:placsp:cantabria": "pnpm --filter=@urban-transparency/scrapper scrape:placsp:cantabria",
    "scrape:placsp:pais-vasco": "pnpm --filter=@urban-transparency/scrapper scrape:placsp:pais-vasco",
    "scrape:placsp:asturias": "pnpm --filter=@urban-transparency/scrapper scrape:placsp:asturias",

    "scrape:dirce": "pnpm --filter=@urban-transparency/scrapper scrape:dirce",
    "scrape:dirce:cantabria": "pnpm --filter=@urban-transparency/scrapper scrape:dirce:cantabria",
    "scrape:dirce:pais-vasco": "pnpm --filter=@urban-transparency/scrapper scrape:dirce:pais-vasco",
    "scrape:dirce:asturias": "pnpm --filter=@urban-transparency/scrapper scrape:dirce:asturias",

    "scrape:adrh": "pnpm --filter=@urban-transparency/scrapper scrape:adrh",
    "scrape:adrh:cantabria": "pnpm --filter=@urban-transparency/scrapper scrape:adrh:cantabria",
    "scrape:adrh:pais-vasco": "pnpm --filter=@urban-transparency/scrapper scrape:adrh:pais-vasco",
    "scrape:adrh:asturias": "pnpm --filter=@urban-transparency/scrapper scrape:adrh:asturias",

    "fetch:region-boundary": "pnpm --filter=@urban-transparency/web fetch:region-boundary",
    "fetch:region-boundary:cantabria": "pnpm --filter=@urban-transparency/web fetch:region-boundary:cantabria",
    "fetch:region-boundary:pais-vasco": "pnpm --filter=@urban-transparency/web fetch:region-boundary:pais-vasco",
    "fetch:region-boundary:asturias": "pnpm --filter=@urban-transparency/web fetch:region-boundary:asturias"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@nx/js": "^23.3.0",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "nx": "^23.3.0",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dlx lint-staged"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  }
}
