{
  "name": "urban-transparency",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "build": "pnpm --filter=@urban-transparency/web build",
    "preview": "pnpm --filter=@urban-transparency/web preview",
    "dev": "pnpm --filter=@urban-transparency/web dev",

    "lint": "eslint . --ignore-pattern 'packages/web/**' && pnpm -r --if-present run lint",
    "lint:fix": "eslint --fix . --ignore-pattern 'packages/web/**' && pnpm -r --if-present run lint:fix",

    "clean": "rm -rf node_modules dist && pnpm -r run clean",
    "phoenix": "pnpm clean && pnpm install",

    "release": "nx release --skip-publish",
    "release:dry": "nx release --dry-run",

    "scrape:placsp": "pnpm --filter=@urban-transparency/scrapper scrape:placsp",
    "scrape:placsp:cantabria": "pnpm --filter=@urban-transparency/scrapper scrape:placsp:cantabria"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@nx/js": "^23.3.0",
    "eslint": "^10.13.0",
    "nx": "^23.3.0"
  }
}
